# Set these in Vercel → Project → Settings → Environment Variables
# (Production and Preview). Never commit real values.

# Claude API key from console.anthropic.com (set a monthly spend limit there)
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your chat id with the bot (send the bot a message, then open
# https://api.telegram.org/bot<token>/getUpdates and copy chat.id)
TELEGRAM_CHAT_ID=

# Optional: extra allowed origins, comma-separated (e.g. http://localhost:3000)
ALLOWED_ORIGINS=
